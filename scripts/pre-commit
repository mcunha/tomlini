#!/usr/bin/env bash
# pre-commit — runs linting checks before every commit.
# Install:  just setup-git-hooks   (or manually:  cp scripts/pre-commit .git/hooks/pre-commit)

set -euo pipefail

echo "==> zizmor (regular persona)"
zizmor --persona regular .github/workflows/

echo "==> cargo fmt"
cargo fmt -p tomlini -- --check

echo "==> cargo clippy"
cargo clippy -p tomlini -- -D warnings

echo "==> ok"
